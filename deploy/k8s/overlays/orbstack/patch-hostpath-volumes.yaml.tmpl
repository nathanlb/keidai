# Generated by deploy/k8s/up.sh for the orbstack overlay — do not edit by hand.
# Template: patch-hostpath-volumes.yaml.tmpl
#
# hostPath targets the same apps/*/data dirs used by local/native runs so
# OrbStack and `pnpm --filter` share SQLite. `$patch: replace` on each volumes
# list so hostPath fully replaces the base PVC (plain strategic merge would
# leave both volume sources). Re-list every other volume from the base
# Deployment — a replace drops anything omitted (e.g. operators).
apiVersion: apps/v1
kind: Deployment
metadata:
  name: fuda
  namespace: keidai
spec:
  template:
    spec:
      volumes:
        - $patch: replace
        - name: data
          hostPath:
            path: __KEIDAI_FUDA_DATA__
            type: DirectoryOrCreate
        - name: signing-key
          secret:
            secretName: fuda-signing
            items:
              - key: dev.pem
                path: dev.pem
                mode: 0400
        - name: operators
          configMap:
            name: keidai-operators
---
