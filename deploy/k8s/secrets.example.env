# =============================================================================
# Copy to deploy/k8s/secrets.env and fill in. Used by up.sh to create the
# keidai-secrets Secret. Do not commit secrets.env.
# =============================================================================

# Fuda signing key PEM (RSA). Leave empty to auto-copy apps/fuda/keys/dev.pem
# or generate a new key during up.sh.
# FUDA_SIGNING_KEY_FILE=../../apps/fuda/keys/dev.pem

# OpenRouter (required for Shaiden runs)
OPEN_ROUTER_API_KEY=

# Torii backend OAuth / service keys (optional for boot; needed for live MCP)
LINEAR_API_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# keidai-ui operator Google OIDC (required for login)
KEIDAI_GOOGLE_CLIENT_ID=
KEIDAI_GOOGLE_CLIENT_SECRET=
KEIDAI_SESSION_SECRET=change-me-to-a-long-random-string-32chars-min
# Align with Fuda seed owner_id / Torii boot_owner_id (demo-owner).
KEIDAI_OWNER_ID=demo-owner
# At least one allowlist entry required.
KEIDAI_OPERATOR_GOOGLE_SUBS=
KEIDAI_OPERATOR_GOOGLE_EMAILS=
