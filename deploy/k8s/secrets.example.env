# =============================================================================
# Copy to deploy/k8s/secrets.env and fill in. Used by up.sh to create the
# keidai-secrets Secret. Do not commit secrets.env.
#
# Owner identity is NOT configured here. Google ↔ opaque owner_id lives in
# operators.yaml (default: deploy/operators.example.yaml → ConfigMap
# keidai-operators). Do not use KEIDAI_OWNER_ID / KEIDAI_OPERATOR_GOOGLE_* /
# boot_owner_id — those are gone.
#
# Redirect URI, cookie Secure, and operators mount paths are set in
# deploy/k8s/base/configmap-apps.yaml (and FUDA_OPERATORS_PATH in
# configmap-fuda.yaml), not in this secrets file.
# =============================================================================

# Fuda signing key PEM (RSA). Leave empty to auto-copy apps/fuda/keys/dev.pem
# or generate a new key during up.sh.
# FUDA_SIGNING_KEY_FILE=../../apps/fuda/keys/dev.pem

# OpenRouter (required for Shaiden runs)
OPEN_ROUTER_API_KEY=

# Torii backend OAuth / service keys (optional for boot; needed for live MCP)
LINEAR_API_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# keidai-ui operator Google OIDC (required for login)
KEIDAI_GOOGLE_CLIENT_ID=
KEIDAI_GOOGLE_CLIENT_SECRET=
KEIDAI_SESSION_SECRET=change-me-to-a-long-random-string-32chars-min
# Operators registry file loaded by up.sh into ConfigMap keidai-operators.
# Defaults to deploy/operators.example.yaml when unset.
# KEIDAI_OPERATORS_FILE=../../deploy/operators.example.yaml
