# =============================================================================
# Copy to deploy/k8s/secrets.env and fill in. Used by up.sh to write
# secrets-values.yaml for Helm. Do not commit secrets.env or secrets-values.yaml.
#
# Owner identity is NOT configured here. Google ↔ opaque owner_id lives in
# operators.yaml (default: deploy/operators.example.yaml → ConfigMap
# keidai-operators).
#
# publicUrl / redirect URI / cookie Secure are Helm values (derived from
# publicUrl), not this secrets file.
#
# App database URLs are derived by the chart from secrets.postgresPassword.
# Do not set *_DB_PATH.
# =============================================================================

# Fuda signing key PEM (RSA). Leave empty to auto-copy apps/fuda/keys/dev.pem
# or generate a new key during up.sh. Never generated inside Helm templates.
# FUDA_SIGNING_KEY_FILE=../../apps/fuda/keys/dev.pem

# Postgres (local kind/OrbStack). Shared by roles fuda/torii/shaiden.
POSTGRES_PASSWORD=keidai-local

# OpenRouter (required for Shaiden runs)
OPEN_ROUTER_API_KEY=

# Torii backend OAuth / service keys (optional for boot; needed for live MCP)
LINEAR_API_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Shared BFF → Torii/Fuda/Shaiden management API token (required for hardened
# stack). Generate: openssl rand -hex 32
# Opt out only with BFF_SERVICE_TOKEN_DISABLED=true (not for real deploys).
BFF_SERVICE_TOKEN=change-me-to-a-long-random-string

# keidai-ui operator Google OIDC (required for login)
KEIDAI_GOOGLE_CLIENT_ID=
KEIDAI_GOOGLE_CLIENT_SECRET=
KEIDAI_SESSION_SECRET=change-me-to-a-long-random-string-32chars-min
# Operators registry file loaded by up.sh into Helm values.operators.
# Defaults to deploy/operators.example.yaml when unset. Relative paths are
# resolved from deploy/k8s/ (same as FUDA_SIGNING_KEY_FILE).
# KEIDAI_OPERATORS_FILE=../../deploy/operators.example.yaml
