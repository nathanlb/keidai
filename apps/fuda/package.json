{
  "name": "@keidai/fuda",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "fuda": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "seed": "tsx scripts/seed.ts",
    "start": "node dist/index.js",
    "test": "tsx --test 'src/**/tests/**/*.test.ts'",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@keidai/shared": "workspace:*",
    "fastify": "^5.11.0",
    "jose": "^6.2.4",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0",
    "yaml": "^2.9.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
