# =============================================================================
# Fuda AIdP — copy to apps/fuda/.env
# Shared vars (e.g. BFF_SERVICE_TOKEN) can live in the repo root .env instead.
# Do not commit .env.
#
# BFF_SERVICE_TOKEN is required: management `/api/agents` and `/api/bearers`
# need Authorization: Bearer <token>. POST /token and JWKS stay on their
# existing agent/public auth models. Opt out with BFF_SERVICE_TOKEN_DISABLED=true.
# =============================================================================

# FUDA_HOST=127.0.0.1
# FUDA_PORT=3300
# Required. Compose/native local:
# FUDA_DATABASE_URL=postgres://fuda:keidai-local@127.0.0.1:5432/fuda
# Comma-separated subset for network-level separation (default: all three)
# FUDA_LISTEN_GROUPS=public,agent,management

# Signing keys — private material stays outside the database (file or env).
# Format: kid=path,kid=env:VAR_NAME
# FUDA_SIGNING_KEYS=2026-07-a=./keys/2026-07-a.pem
# FUDA_SIGNING_KID=2026-07-a

# Issuer URL stamped on minted agent identity tokens (`iss` claim).
# Torii verifies this against its configured Fuda issuer.
# FUDA_ISSUER=https://fuda.local

# Subject token validator (required when FUDA_LISTEN_GROUPS includes agent).
# Shared secret Shaiden presents (same value as SHAIDEN_BEARER). Comma-list
# for rotation overlap. Allowed subjects resolve to shaiden-runner.
# FUDA_STATIC_SUBJECT_TOKEN=dev-secret
#
# Operators registry (Google ↔ opaque owner_id). Reconciled into the owners
# table at boot when set. For local pnpm fuda:dev use the host-relative path.
# Docker Compose overrides this to /app/operators/operators.yaml (mounted).
# FUDA_OPERATORS_PATH=../../deploy/operators.example.yaml
#
# Do not set FUDA_STATIC_SUBJECT_TOKEN together with FUDA_K8S_SA_OIDC_* (ambiguous).
# Cluster: projected SA OIDC.
# FUDA_K8S_SA_OIDC_ISSUER=
# FUDA_K8S_SA_OIDC_AUDIENCE=fuda
# FUDA_K8S_SA_OIDC_JWKS_URI=
# Format: namespace/serviceAccount,...
# FUDA_K8S_SA_OIDC_SUBJECTS=keidai/shaiden
