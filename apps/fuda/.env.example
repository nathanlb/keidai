# =============================================================================
# Fuda AIdP — copy to apps/fuda/.env
# Shared vars can live in the repo root .env instead.
# Do not commit .env.
# =============================================================================

# FUDA_HOST=127.0.0.1
# FUDA_PORT=3300
# FUDA_DB_PATH=./data/fuda.db
# Comma-separated subset for network-level separation (default: all three)
# FUDA_LISTEN_GROUPS=public,agent,management

# Signing keys — private material stays outside sqlite (file or env).
# Format: kid=path,kid=env:VAR_NAME
# FUDA_SIGNING_KEYS=2026-07-a=./keys/2026-07-a.pem
# FUDA_SIGNING_KID=2026-07-a

# Issuer URL stamped on minted agent identity tokens (`iss` claim).
# Torii verifies this against its configured Fuda issuer.
# FUDA_ISSUER=https://fuda.local

# Subject token validator (required when FUDA_LISTEN_GROUPS includes agent).
# Static shared-secret → bearer_id for local/pre-cluster use.
# Format: credential=bearer_id,credential=bearer_id
# Map SHAIDEN_BEARER to a bearer_id created via the management API / keidai-ui.
# FUDA_STATIC_SUBJECT_MAPPINGS=dev-secret=local-dev
#
# Operators registry (Google ↔ opaque owner_id). Reconciled into the owners
# table at boot when set.
# FUDA_OPERATORS_PATH=../../deploy/operators.example.yaml
#
# Do not set static mappings together with FUDA_K8S_SA_OIDC_* (ambiguous).
# Cluster: projected SA OIDC (unit-tested; cluster integration pending).
# FUDA_K8S_SA_OIDC_ISSUER=
# FUDA_K8S_SA_OIDC_AUDIENCE=fuda
# FUDA_K8S_SA_OIDC_JWKS_URI=
# Format: namespace/serviceAccount=bearer_id,...
# FUDA_K8S_SA_OIDC_SUBJECT_MAPPINGS=agents/catalog-agent=catalog-runner
