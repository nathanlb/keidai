# =============================================================================
# Shaiden agent runtime — copy to apps/shaiden/.env
# Shared vars (e.g. SHAIDEN_BEARER, BFF_SERVICE_TOKEN) can live in the repo
# root .env instead. Do not commit .env.
#
# BFF_SERVICE_TOKEN is required: `/api/tasks` and `/api/runs` need
# Authorization: Bearer <token>. `/api/health` stays open for probes.
# Opt out with BFF_SERVICE_TOKEN_DISABLED=true (tests / insecure local only).
# =============================================================================

TORII_MCP_URL=http://127.0.0.1:3100/mcp
FUDA_URL=http://127.0.0.1:3300
SHAIDEN_BEARER=
# In-cluster: set SHAIDEN_SUBJECT_TOKEN_FILE instead (xor with SHAIDEN_BEARER).
# SHAIDEN_SUBJECT_TOKEN_FILE=/var/run/secrets/tokens/token
OPEN_ROUTER_API_KEY=
# SHAIDEN_MODEL_ID=google/gemini-2.5-flash
# SHAIDEN_HOST=127.0.0.1
# SHAIDEN_PORT=3200
# SHAIDEN_DB_PATH=./data/shaiden.db
# Optional. Identifies this process when claiming parked runs across replicas.
# SHAIDEN_REPLICA_ID=shaiden-a
