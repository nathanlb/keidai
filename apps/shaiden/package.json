  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "tsx --test 'src/**/tests/**/*.test.ts'",
    "eval": "tsx --tsconfig tsconfig.eval.json --test 'eval/**/*.live.eval.ts'",
    "typecheck": "tsc -p tsconfig.check.json --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai": "^2.0.122",
    "@keidai/postgres": "workspace:*",
    "@keidai/shared": "workspace:*",
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/core": "^2.0.0",
    "ai": "^5.0.249",
    "fastify": "5.12.1",
    "zod": "^4.5.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "reflect-metadata": "^0.2.2",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
