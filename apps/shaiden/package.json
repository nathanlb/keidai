{
  "name": "@keidai/shaiden",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "tsx --test 'src/**/tests/**/*.test.ts'",
    "eval": "tsx --tsconfig tsconfig.eval.json --test 'eval/**/*.live.eval.ts'",
    "typecheck": "tsc -p tsconfig.check.json --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai": "^2.0.116",
    "@keidai/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ai": "^5.0.222",
    "fastify": "^5.10.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "reflect-metadata": "^0.2.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
