  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "tsx --test 'src/**/tests/**/*.test.ts'",
    "eval": "tsx --tsconfig tsconfig.eval.json --test 'eval/**/*.live.eval.ts'",
    "typecheck": "tsc -p tsconfig.check.json --noEmit"
  },
  "dependencies": {
    "@ai-sdk/openai": "^2.0.130",
    "@keidai/postgres": "workspace:*",
    "@keidai/shared": "workspace:*",
    "@modelcontextprotocol/client": "^2.1.0",
    "@modelcontextprotocol/core": "^2.1.0",
    "ai": "^5.0.267",
    "fastify": "5.12.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "reflect-metadata": "^0.2.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
