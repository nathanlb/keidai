# =============================================================================
# Torii gateway — copy to apps/torii/.env
# Shared vars (e.g. DEMO_AGENT_BEARER, BFF_SERVICE_TOKEN) can live in the repo
# root .env instead. Do not commit .env.
#
# BFF_SERVICE_TOKEN is required: management `/api/*` (except `/api/health`)
# need Authorization: Bearer <token>. `/mcp` stays on Fuda JWT auth.
# Opt out with BFF_SERVICE_TOKEN_DISABLED=true (tests / insecure local only).
# =============================================================================

# Public operator edge (keidai-ui BFF / Vite), not Torii's listen port.
# Used as OAuth redirect_uri base: {base}/oauth/callback/{provider}
# Must be localhost (not 127.0.0.1) to match IdP registrations and k8s.
# Docker Compose pins this to http://localhost:3000 in docker-compose.yml.
TORII_GATEWAY_BASE_URL=http://localhost:3000
# Seals connector secrets (service keys, OAuth client secrets) at rest.
# Required outside tests. Compose defaults a local-dev value.
# TORII_SECRET_KEY=
# TORII_PORT=3100
# TORII_HOST=127.0.0.1
# Required. Compose/native local:
# TORII_DATABASE_URL=postgres://torii:keidai-local@127.0.0.1:5432/torii
#
# Operators registry (Google ↔ opaque owner_id). When set, Torii wipes
# OAuth tokens and pending links for owner_ids absent from the file at boot.
# For local pnpm --filter @keidai/torii dev use the host-relative path.
# Docker Compose overrides this to /app/operators/operators.yaml (mounted).
# TORII_OPERATORS_PATH=../../deploy/operators.example.yaml


# Production identity — Fuda-minted JWTs (required)
# Must match FUDA_ISSUER; JWKS is Fuda's public route.
# TORII_FUDA_ISSUER=https://fuda.local
# TORII_FUDA_JWKS_URI=http://127.0.0.1:3300/.well-known/jwks.json
# (docker compose sets JWKS to http://fuda:3300/.well-known/jwks.json)

# Optional tracing
# OTEL_EXPORTER_OTLP_ENDPOINT=
