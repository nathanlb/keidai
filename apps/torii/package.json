{
  "name": "@keidai/torii",
  "version": "0.8.0",
  "private": true,
  "license": "Apache-2.0",
  "bin": {
    "torii": "./dist/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "torii": "tsx src/index.ts",
    "dev:inspect": "tsx scripts/run-mcp-inspector.ts",
    "test": "tsx --test 'src/**/tests/**/*.test.ts'",
    "typecheck": "tsc -p tsconfig.build.json --noEmit && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@keidai/postgres": "workspace:*",
    "@keidai/shared": "workspace:*",
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/fastify": "^2.0.1",
    "@modelcontextprotocol/node": "^2.1.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.219.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "fastify": "5.12.5",
    "jose": "^6.2.12",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.10.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/inspector": "^2.10.1",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
