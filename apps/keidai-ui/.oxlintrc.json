{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "react"],
  "jsPlugins": ["oxlint-tailwindcss"],
  "settings": {
    "tailwindcss": {
      "entryPoint": "../../packages/ui/src/styles/globals.css",
      "rootFontSize": 16
    }
  },
  "rules": {
    "no-unused-vars": "off",
    "typescript/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ],
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "warn",
    "tailwindcss/no-unknown-classes": [
      "error",
      {
        "ignorePrefixes": ["run-log-"]
      }
    ],
    "tailwindcss/no-duplicate-classes": "error",
    "tailwindcss/no-conflicting-classes": "error",
    "tailwindcss/no-deprecated-classes": "error",
    "tailwindcss/no-unnecessary-whitespace": "error",
    "tailwindcss/enforce-canonical": "error",
    "tailwindcss/enforce-sort-order": "warn",
    "tailwindcss/enforce-shorthand": "warn",
    "tailwindcss/enforce-consistent-important-position": "warn",
    "tailwindcss/enforce-negative-arbitrary-values": "warn",
    "tailwindcss/enforce-consistent-variable-syntax": "warn",
    "tailwindcss/consistent-variant-order": "warn",
    "tailwindcss/no-hardcoded-colors": "warn",
    "tailwindcss/no-unnecessary-arbitrary-value": "warn",
    "tailwindcss/no-dark-without-light": "off",
    "tailwindcss/no-contradicting-variants": "off",
    "tailwindcss/enforce-logical": "off",
    "tailwindcss/enforce-physical": "off",
    "tailwindcss/enforce-consistent-line-wrapping": "off"
  },
  "overrides": [
    {
      "files": ["src/**/*.{ts,tsx}"],
      "env": {
        "browser": true
      }
    },
    {
      "files": ["server/**/*.{ts,tsx}"],
      "env": {
        "node": true
      }
    },
    {
      "files": ["e2e/**/*.{ts,tsx}"],
      "env": {
        "browser": true,
        "node": true
      }
    },
    {
      "files": ["scripts/**/*.{js,mjs,cjs}"],
      "env": {
        "node": true
      }
    }
  ],
  "ignorePatterns": ["dist", "coverage", "playwright-report", "test-results"]
}
