# =============================================================================
# keidai-ui BFF — copy to apps/keidai-ui/.env
# Loaded via loadEnvForPackage() after the repo root .env.
# Do not commit .env.
#
# Google OIDC here is operator login only — distinct from Torii oauth_providers.
# =============================================================================

# KEIDAI_UI_HOST=127.0.0.1
# KEIDAI_UI_PORT=3000

KEIDAI_GOOGLE_CLIENT_ID=
KEIDAI_GOOGLE_CLIENT_SECRET=
# Must match an authorized redirect URI on the Google OAuth client.
KEIDAI_GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/auth/callback
# ≥32 characters; used to seal the HttpOnly session cookie.
KEIDAI_SESSION_SECRET=change-me-to-a-long-random-string-32+
# v0 single owner — align with Torii boot_owner_id / Fuda seed owner_id.
KEIDAI_OWNER_ID=nathanlb
# Comma-separated allowlists (at least one entry across both vars).
KEIDAI_OPERATOR_GOOGLE_SUBS=
KEIDAI_OPERATOR_GOOGLE_EMAILS=
# Set true behind HTTPS. Defaults to true when NODE_ENV=production.
KEIDAI_COOKIE_SECURE=false
