# =============================================================================
# keidai-ui BFF — copy to apps/keidai-ui/.env
# Loaded via loadEnvForPackage() after the repo root .env.
# Do not commit .env.
#
# Google OIDC here is operator login only — distinct from Torii oauth_providers.
# =============================================================================

# KEIDAI_UI_HOST=127.0.0.1
# KEIDAI_UI_PORT=3000
# Local Vite (`pnpm dev`) proxies /api,/auth,/oauth to the API-only BFF:
# KEIDAI_UI_BFF_PORT=3001
# VITE_BFF_URL=http://127.0.0.1:3001

KEIDAI_GOOGLE_CLIENT_ID=
KEIDAI_GOOGLE_CLIENT_SECRET=
# Must match an authorized redirect URI on the Google OAuth client.
# Browser origin is Vite (`http://localhost:3000`); the BFF receives the
# callback via the Vite proxy. Use localhost (not 127.0.0.1) to match IdPs/k8s.
KEIDAI_GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback
# ≥32 characters; used to seal the HttpOnly session cookie.
KEIDAI_SESSION_SECRET=change-me-to-a-long-random-string-32+
# Google ↔ opaque owner_id registry (SSOT; also reconciled into Fuda owners).
# For local pnpm ui:dev use the host-relative path. Docker Compose overrides
# this to /app/operators/operators.yaml (mounted from deploy/operators.example.yaml).
KEIDAI_OPERATORS_PATH=../../deploy/operators.example.yaml
# Set true behind HTTPS. Defaults to true when NODE_ENV=production.
# Docker Compose pins KEIDAI_COOKIE_SECURE=false for http://localhost:3000.
KEIDAI_COOKIE_SECURE=false

# Display-only addresses in the health footer (API traffic is same-origin via BFF).
# Omit to show "<NAME> unset" in the footer — do not invent silent localhost defaults.
VITE_TORII_URL=http://127.0.0.1:3100
VITE_SHAIDEN_URL=http://127.0.0.1:3200
VITE_FUDA_URL=http://127.0.0.1:3300
