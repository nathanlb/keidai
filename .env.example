# =============================================================================
# Shared dev secrets — copy to .env at the repo root.
# Loaded by all apps via loadEnvForPackage() before app-specific .env files.
# Do not commit .env.
# =============================================================================

# Used by Torii (torii.demo.yaml inbound_token) and demo-agent (Authorization header)
DEMO_AGENT_BEARER=change-me-to-a-long-random-string

# Used by Shaiden as the Fuda subject token (token exchange), and by Fuda's
# static subject validator mapping when seeded for local demo.
SHAIDEN_BEARER=change-me-to-a-long-random-string

# Fuda — issuer claim on minted JWTs (must match Torii's TORII_FUDA_ISSUER).
FUDA_ISSUER=https://fuda.local

# Fuda base URL for local (non-compose) Shaiden. Compose sets Shaiden to
# http://fuda:3300 and Torii JWKS to http://fuda:3300/.well-known/jwks.json.
FUDA_URL=http://127.0.0.1:3300

# Docker Compose mounts apps/fuda/keys/dev.pem into the Fuda container.
# Generate once (never commit private keys):
#   mkdir -p apps/fuda/keys
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out apps/fuda/keys/dev.pem
#   chmod 600 apps/fuda/keys/dev.pem

# -----------------------------------------------------------------------------
# keidai-ui BFF — Google OIDC operator login (required for `docker compose` /
# `pnpm --filter @keidai/keidai-ui start`). Distinct from Torii oauth_providers.
# -----------------------------------------------------------------------------
KEIDAI_GOOGLE_CLIENT_ID=
KEIDAI_GOOGLE_CLIENT_SECRET=
# Must match an authorized redirect URI on the Google OAuth client.
KEIDAI_GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/auth/callback
# ≥32 characters; used to seal the HttpOnly session cookie.
KEIDAI_SESSION_SECRET=change-me-to-a-long-random-string-32+
# v0 single owner — align with Torii boot_owner_id / Fuda seed owner_id.
KEIDAI_OWNER_ID=nathanlb
# Comma-separated allowlists (at least one entry across both vars).
KEIDAI_OPERATOR_GOOGLE_SUBS=
KEIDAI_OPERATOR_GOOGLE_EMAILS=
# Set true behind HTTPS. Defaults to true when NODE_ENV=production.
# KEIDAI_COOKIE_SECURE=false
