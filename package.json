{
  "name": "keidai",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "services:dev": "turbo run dev --filter=@keidai/fuda --filter=@keidai/torii --filter=@keidai/shaiden --filter=@keidai/keidai-ui",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint --fix",
    "fmt": "oxfmt --disable-nested-config",
    "fmt:check": "oxfmt --check --disable-nested-config",
    "prepare": "husky",
    "torii:dev": "pnpm --filter @keidai/torii dev",
    "shaiden": "pnpm --filter @keidai/shaiden start",
    "shaiden:dev": "pnpm --filter @keidai/shaiden dev",
    "fuda": "pnpm --filter @keidai/fuda start",
    "fuda:dev": "pnpm --filter @keidai/fuda dev",
    "ui": "pnpm --filter @keidai/keidai-ui dev",
    "ui:dev": "pnpm --filter @keidai/keidai-ui dev",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up",
    "docker:down": "docker compose down",
    "k8s:up": "bash deploy/k8s/up.sh kind",
    "k8s:up:kind": "bash deploy/k8s/up.sh kind",
    "k8s:up:orbstack": "bash deploy/k8s/up.sh orbstack",
    "k8s:up:k3s": "bash deploy/k8s/up.sh k3s",
    "k8s:down": "bash deploy/k8s/down.sh kind",
    "k8s:down:kind": "bash deploy/k8s/down.sh kind",
    "k8s:down:orbstack": "bash deploy/k8s/down.sh orbstack",
    "k8s:down:k3s": "bash deploy/k8s/down.sh k3s",
    "changeset": "changeset",
    "version-packages": "changeset version && node scripts/sync-chart-version.mjs",
    "check-versions": "node scripts/check-versions.mjs",
    "prepare-release": "node scripts/prepare-release-changeset.mjs",
    "test:scripts": "node --test scripts/lib/release-changelog.test.mjs",
    "upgrade:all": "pnpm upgrade --recursive --include-workspace-root"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "oxfmt": "^0.70.0",
    "turbo": "^2.11.7",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*": "pnpm fmt --"
  },
  "engines": {
    "node": "24"
  },
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61"
}
