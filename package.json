{
  "name": "keidai",
  "private": true,
  "license": "Apache-2.0",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "torii:dev": "pnpm --filter @keidai/torii dev",
    "shaiden": "pnpm --filter @keidai/shaiden start",
    "shaiden:dev": "pnpm --filter @keidai/shaiden dev",
    "fuda": "pnpm --filter @keidai/fuda start",
    "fuda:dev": "pnpm --filter @keidai/fuda dev",
    "ui": "pnpm --filter @keidai/keidai-ui dev",
    "ui:dev": "pnpm --filter @keidai/keidai-ui dev",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "turbo": "^2.10.8",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee"
